# ==========================================
# CẤU HÌNH MÔI TRƯỜNG KẾT NỐI DỮ LIỆU (ENVIRONMENT CONFIG)
# ERP ACC & WEBSHOP E-COMMERCE SYSTEM
# ==========================================

# ------------------------------------------
# 1. KẾT NỐI DỮ LIỆU SUPABASE POSTGRESQL (ONLINE)
# ------------------------------------------
# SUPABASE_DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------
# 2. MÔI TRƯỜNG LOCALHOST (TEST TẠI MÁY CHỦ CỤC BỘ)
# ------------------------------------------
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=erpacc_db

# ------------------------------------------
# 3. CẤU HÌNH NETLIFY & PRODUCTION SERVER
# ------------------------------------------
NODE_ENV=production
PORT=3000
JWT_SECRET_KEY=erpacc-super-secret-jwt-key-2026

# ------------------------------------------
# 4. KẾT NỐI API FRONTEND (VITE CLIENT)
# ------------------------------------------
VITE_API_BASE_URL=/api

# ==========================================
# CẤU HÌNH MÔI TRƯỜNG KẾT NỐI DỮ LIỆU (ENVIRONMENT CONFIG)
# ERP ACC & WEBSHOP E-COMMERCE SYSTEM
# ==========================================

# ------------------------------------------
# 1. MÔI TRƯỜNG LOCALHOST (TEST TẠI MÁY CHỦ CỤC BỘ)
# ------------------------------------------
# Lựa chọn A: Sử dụng Connection String ngắn gọn
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/erpacc_db

# Lựa chọn B: Sử dụng các biến chi tiết từng tham số
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=erpacc_db

# ------------------------------------------
# 2. MÔI TRƯỜNG ONLINE / PRODUCTION (DEPLOYS)
# ------------------------------------------
# Chuỗi kết nối PostgreSQL Online (Cloud SQL / Supabase / Neon / Render PostgreSQL)
# Hỗ trợ tự động bật SSL mã hóa an toàn khi NODE_ENV=production
# DATABASE_URL=postgresql://user:password@cloud-db-host.com:5432/dbname?sslmode=require

NODE_ENV=development
PORT=3000

# ------------------------------------------
# 3. KẾT NỐI API FRONTEND (VITE CLIENT)
# ------------------------------------------
# Khi chạy Localhost (Đấu nối trực tiếp Node.js Proxy server):
VITE_API_BASE_URL=/api

# Khi chạy Online tách biệt Frontend / Backend:
# VITE_API_BASE_URL=https://api.yourdomain.com/api
